   "name": "Modo teste?",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    220,
    0
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT coalesce((SELECT valor FROM config WHERE chave = 'modo_teste'), '0') = '1' AS teste, coalesce((SELECT valor FROM config WHERE chave = 'prefixo_teste'), '') AS prefixo;",
    "options": {}
   },
   "credentials": {
    "postgres": {
     "id": "clarapg0000001",
     "name": "Postgres Clara"
    }
   },
   "executeOnce": true
  },
  {
   "id": "3dd1118f-eeb9-5937-92a4-e44a13e7eec0",
   "name": "Montar mensagens",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "jsCode": "// Teste quando o modo teste geral está ligado OU quando o pedido envolve um número de teste\n// (prefixo em config.prefixo_teste). Nesse caso o lote inteiro, inclusive os avisos para a\n// equipe, vai para a tabela saidas_teste e nada sai pelo WhatsApp.\nconst cfg = $('Modo teste?').first().json;\nconst pedidos = $('Recebe pedido de envio').all();\nconst prefixo = String(cfg.prefixo || '').trim();\nconst loteTeste = !!prefixo && pedidos.some(it => String(it.json.phone || '').replace(/\\D/g, '').startsWith(prefixo));\nconst teste = !!cfg.teste || loteTeste;\nconst saida = [];\nfor (const it of pedidos) {\n  const j = it.json;\n  const phone = String(j.phone || '').replace(/\\D/g, '');\n  if (!phone) continue;   // proteção: sem telefone não envia nada\n  const ms = [j.m1, j.m2, j.m3].map(x => (x == null ? '' : String(x)).trim()).filter(Boolean);\n  ms.forEach((body, i) => {\n    const typing = j.sem_digitar ? 1 : Math.min(30, Math.max(3, Math.round(body.length / 5)));\n    saida.push({ json: { to: phone, body, typing_time: typing,\n      espera: i < ms.length - 1 ? typing + 1 : 1, teste } });\n  });\n}\nreturn saida;"
   }
  },
