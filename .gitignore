# Chaves e segredos: nunca entram no repositório (ficam só no .env da raiz do projeto)
.env
.env.*
*.key
*.pem

# Cache de ferramentas e plugins
.claude/data/
__pycache__/
*.pyc

# Dados de pacientes reais nunca ficam nesta pasta.
# Se algum dia houver exportações de conversas reais, use esta pasta (fica fora do Git):
dados-reais/

# Caminho secreto do webhook da Clara e fluxos gerados que o contêm
tecnico/n8n/segredos.local.json
tecnico/n8n/clara-*.json

# Saída dos geradores (contém o caminho secreto do webhook e a config de cada clínica)
tecnico/n8n/gerados/

# Mapa gerado pelo Graphify (refazer com graphify update)
graphify-out/

# Cópia dos arquivos de trabalho do Codex que estavam no OneDrive: só no computador
arquivo/codex/onedrive/
